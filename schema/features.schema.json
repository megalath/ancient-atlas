{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ancient-atlas.dev/schema/features.schema.json",
  "title": "Atlas features",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "features"],
  "properties": {
    "schemaVersion": { "enum": [1] },
    "features": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "group", "layer", "accuracy", "material", "description", "links", "images", "geometry"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "name": { "type": "string", "minLength": 2 },
          "group": {
            "enum": ["Exterior", "Passages", "Chambers", "Shafts", "Voids", "Intrusions", "Airfield", "Terrain", "Installation", "Craft", "Claims"]
          },
          "layer": {
            "enum": ["casing", "core", "interior", "terrain", "airfield", "buildings", "boundary", "s4", "hull", "craft-interior"]
          },
          "accuracy": { "enum": ["surveyed", "reconstructed", "projected", "schematic"] },
          "evidence": { "enum": ["verified", "testimony", "estimated"] },
          "scene": { "enum": ["monument", "terrain", "sport-model"] },
          "schematic": { "type": "boolean" },
          "material": {
            "enum": ["casing", "core", "passage", "granite", "bedrock", "shaft", "void", "forced", "chevron", "sand", "asphalt", "water", "metal", "reactor"]
          },
          "description": { "type": "string", "minLength": 1 },
          "links": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["label", "url"],
              "properties": {
                "label": { "type": "string", "minLength": 2 },
                "url": { "type": "string", "pattern": "^https?://" },
                "sourceId": { "type": "string", "minLength": 2 }
              }
            }
          },
          "images": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "title", "page", "author", "license"],
              "properties": {
                "id": { "type": "string", "minLength": 1 },
                "title": { "type": "string", "minLength": 2 },
                "file": { "type": "string" },
                "url": { "type": "string" },
                "wikimediaUrl": { "type": "string" },
                "page": { "type": "string" },
                "author": { "type": "string", "minLength": 2 },
                "license": { "type": "string", "minLength": 2 },
                "licenseUrl": { "type": "string" }
              }
            }
          },
          "facts": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": true,
              "required": ["label", "value", "sourceId"],
              "properties": {
                "label": { "type": "string" },
                "value": { "type": "string" },
                "sourceId": { "type": "string" },
                "locator": { "type": "string" },
                "evidence": { "enum": ["verified", "testimony", "estimated"] }
              }
            }
          },
          "geometry": {}
        }
      }
    }
  }
}
