{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ancient-atlas.dev/schema/sources.schema.json",
  "title": "Atlas sources",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "sources"],
  "properties": {
    "schemaVersion": { "enum": [1] },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "authors", "year", "title", "url"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "authors": { "type": "string", "minLength": 2 },
          "year": { "type": "integer", "minimum": 1500, "maximum": 2100 },
          "title": { "type": "string", "minLength": 2 },
          "container": { "type": "string" },
          "url": { "type": "string", "minLength": 8 },
          "note": { "type": "string" }
        }
      }
    }
  }
}
